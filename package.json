{
    "name": "vite-plugin-ai-auto-i18n",
    "version": "0.1.0",
    "type": "module",
    "description": "Implicit, build-time AI localization for JSX applications",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/runtime/index.ts src/cli/prune.ts --format esm --dts",
        "prune": "npm run build && node dist/cli/prune.js --directory example/.autoi18n --retention-minutes 0",
        "example:dev": "vite example",
        "example:build": "vite build example",
        "preview": "vite build example && vite preview example --port 4173 --strictPort",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "vite": ">=5"
    },
    "dependencies": {
        "@babel/generator": "^7.26.0",
        "@babel/parser": "^7.26.0",
        "@babel/traverse": "^7.26.0",
        "@babel/types": "^7.26.0",
        "fast-glob": "^3.3.2"
    },
    "devDependencies": {
        "@types/babel__generator": "^7.6.8",
        "@types/babel__traverse": "^7.20.6",
        "@types/node": "^22.10.0",
        "@vitejs/plugin-react": "^4.3.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "vite": "^6.0.0",
        "vitest": "^2.1.8"
    }
}
