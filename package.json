{
    "name": "vite-plugin-ai-auto-i18n",
    "version": "0.9.1",
    "type": "module",
    "description": "Implicit, build-time AI localization for JSX applications",
    "license": "ISC",
    "engines": {
        "node": ">=26.0.0"
    },
    "keywords": [
        "vite",
        "vite-plugin",
        "i18n",
        "localization",
        "translation",
        "react",
        "jsx",
        "ai"
    ],
    "homepage": "https://github.com/rand0mC0d3r/vite-plugin-ai-i18n#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rand0mC0d3r/vite-plugin-ai-i18n.git"
    },
    "bugs": {
        "url": "https://github.com/rand0mC0d3r/vite-plugin-ai-i18n/issues"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "analyze": "ANALYZE=1 tsdown",
        "prepublishOnly": "npm run build",
        "prune": "npm run build && node dist/cli/prune.js --directory example/.autoi18n --retention-minutes 0",
        "stats": "npm run build && node dist/cli/stats.js --directory example/.autoi18n",
        "example:dev": "vite example",
        "example:build": "vite build example",
        "preview": "vite build example && vite preview example --port 4173 --strictPort",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.reporter=text --coverage.reporter=json-summary",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "rolldown": "^1.2.18",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "arktype": "^2.2.9",
        "intl-messageformat": "^12.1.5",
        "magic-string": "^1.4.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rolldown": "^1.3.2",
        "rollup-plugin-visualizer": "^7.1.3",
        "tsdown": "^0.23.7",
        "typescript": "^7.1.0-beta",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
