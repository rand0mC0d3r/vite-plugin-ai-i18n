{
    "name": "vite-plugin-ai-auto-i18n",
    "version": "0.5.2",
    "type": "module",
    "description": "Implicit, build-time AI localization for JSX applications",
    "license": "ISC",
    "engines": {
        "node": ">=26.0.0"
    },
    "keywords": [
        "vite-plugin"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "analyze": "ANALYZE=1 tsdown",
        "prepublishOnly": "npm run build",
        "prune": "npm run build && node dist/cli/prune.js --directory example/.autoi18n --retention-minutes 0",
        "example:dev": "vite example",
        "example:build": "vite build example",
        "preview": "vite build example && vite preview example --port 4173 --strictPort",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "vite": "^8.3.7"
    },
    "dependencies": {
        "magic-string": "^1.4.5",
        "oxc-parser": "^0.158.0",
        "tinyglobby": "^0.2.17",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rollup-plugin-visualizer": "^7.1.3",
        "tsdown": "^0.23.7",
        "typescript": "^7.1.0-beta",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    }
}
