{
  "name": "vite-plugin-ai-auto-i18n",
  "version": "0.9.25",
  "description": "Build-time AI localization for strings marked with t() in Vite applications",
  "keywords": [
    "ai",
    "i18n",
    "localization",
    "react",
    "translation",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/rand0mC0d3r/vite-plugin-ai-i18n#readme",
  "bugs": {
    "url": "https://github.com/rand0mC0d3r/vite-plugin-ai-i18n/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rand0mC0d3r/vite-plugin-ai-i18n.git"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun -e \"import { runChecks } from './scripts/check.ts'; process.exitCode = runChecks();\"",
    "analyze": "ANALYZE=1 tsdown",
    "prepublishOnly": "bun run build",
    "prune": "bun run build && node dist/cli/prune.js --directory example/.autoi18n --retention-minutes 0",
    "stats": "bun run build && node dist/cli/stats.js --directory example/.autoi18n",
    "example:dev": "vite example",
    "example:build": "vite build example",
    "preview": "vite build example && vite preview example --port 4173 --strictPort",
    "fmt:check": "bun fmt --check",
    "lint:check": "bun lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.reporter=text --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.23",
    "arktype": "2.2.10",
    "intl-messageformat": "12.2.1",
    "magic-string": "^1.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "react": "19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "1.3.3",
    "rollup-plugin-visualizer": "^7.1.3",
    "tsdown": "^0.23.7",
    "typescript": "^7.1.0-beta",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.4-canary.20261114.1"
}
